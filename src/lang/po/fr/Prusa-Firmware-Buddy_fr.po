#: src/feature/compatibility_checks/gcode_compatibility.cpp:84
msgid ""
"G-Code is not sliced with Input Shaping support. Slicing with IS "
"significantly shortens printing time."
msgstr ""
"Le G-code n'est pas découpé avec la prise en charge de l'Input Shaping. Le "
"découpage avec IS réduit considérablement le temps d'impression."

#: src/feature/compatibility_checks/gcode_compatibility.cpp:93
msgid ""
"G-Code is not sliced with newest INDX profiles. There will be some issues "
"with the print."
msgstr ""
"Le G-code n'est pas découpé avec les profils INDX les plus récents. Il y "
"aura quelques problèmes avec l'impression."

#: src/feature/compatibility_checks/gcode_compatibility.cpp:103
msgid ""
"G-Code is sliced for MMU, but the MMU is not enabled on the printer. Cannot "
"print."
msgstr ""
"Le G-code est découpé pour le MMU, mais le MMU n'est pas activé sur "
"l'imprimante. Impossible d'imprimer."

#: src/feature/compatibility_checks/gcode_compatibility.cpp:190
msgid ""
"G-Code is sliced for a different filament type than what is currently loaded "
"in the assigned tool."
msgstr ""
"Le G-code est découpé pour un type de filament différent de celui "
"actuellement chargé dans l'outil assigné."

#: src/feature/compatibility_checks/gcode_compatibility.cpp:50
msgid "G-Code is sliced for a different printer and is not compatible."
msgstr ""
"Le G-code est découpé pour une imprimante différente et n'est pas compatible."

#: src/feature/compatibility_checks/gcode_compatibility.cpp:150
msgid "G-Code is sliced for a different tool diameter."
msgstr "Le G-code est découpé pour un diamètre d'outil différent."

#: src/feature/compatibility_checks/gcode_compatibility.cpp:59
msgid "G-Code is sliced for a different, but compatible printer model."
msgstr ""
"Le G-code est découpé pour un modèle d'imprimante différent, mais compatible."

#: src/feature/compatibility_checks/gcode_compatibility.cpp:158
msgid ""
"G-Code is sliced for a hardened nozzle. Non-hardened nozzles can get damaged "
"due to material abrasivity."
msgstr ""
"Le G-code est découpé pour une buse durcie. Les buses non durcies peuvent "
"être endommagées par l'abrasivité du matériau."

#: src/feature/compatibility_checks/gcode_compatibility.cpp:166
msgid ""
"G-Code is sliced for a high-flow nozzle. Printing with standard nozzle can "
"lead to underextrusion and extruder skipping."
msgstr ""
"Le G-code est découpé pour une buse à haut débit. L'impression avec une buse "
"standard peut entraîner une sous-extrusion et des sauts de l'extrudeur."

#: src/feature/compatibility_checks/gcode_compatibility.cpp:174
msgid ""
"G-Code is sliced for a non-high flow nozzle. High-flow nozzles require more "
"purging, so printing a MMU print with a high-flow nozzle can result in a "
"color creep."
msgstr ""
"Le G-code est découpé pour une buse à débit non élevé. Les buses à haut "
"débit nécessitent une purge plus fréquente ; par conséquent, l'impression "
"d'une impression MMU avec une buse à haut débit peut entraîner une dérive de "
"couleur."

#: src/feature/compatibility_checks/gcode_compatibility.cpp:76
msgid ""
"G-Code requires features from a newer firmare version to function properly."
msgstr ""
"Le G-Code nécessite des fonctionnalités d'une version plus récente du "
"firmware pour fonctionner correctement."

#: src/feature/compatibility_checks/gcode_compatibility.cpp:120
msgid "G-Code requires more tools than are currently enabled."
msgstr "Le G-code nécessite plus d'outils que ceux actuellement activés."

#: src/feature/compatibility_checks/gcode_compatibility.cpp:112
msgid "G-Code requires some features the printer does not have."
msgstr ""
"Le G-code nécessite certaines fonctionnalités dont l'imprimante ne dispose "
"pas."

