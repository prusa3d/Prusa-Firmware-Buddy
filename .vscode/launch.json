            "name": "Unit-tests debug",
            "type": "gdb",
            "request": "launch",
            "gdbpath": "gdb",
            // Note: replace this with whatever test you want to debug:
            "target": "${workspaceRoot}/build/tests/tests/unit/connect/connect_tests",
            "cwd": "${workspaceRoot}/build/tests/tests/unit/connect",
            "debugger_args": [
                "-d",
                "${workspaceRoot}"
            ]
        },
