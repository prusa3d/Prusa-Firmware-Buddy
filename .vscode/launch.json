            "preLaunchTask": "Wait 1", // this is needed when starting all puppies at once, because there is some issue when all of them start at once
            "rttConfig": {
                "enabled": false,
                "address": "auto",
                "searchSize": 16,
                "searchId": "SEGGER RTT",
                "clearSearch": true,
                "polling_interval": 10,
