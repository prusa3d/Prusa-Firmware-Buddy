                        "noprompt": true,
                        "type": "console",
                        "logfile": "${command:cmake.buildDirectory}/indx_head-build/rtt_log.txt"
                    }
                ]
            },
            "postLaunchCommands": [
                "monitor reset halt",
                "set $sp = *0x08002000",
                "set $pc = *0x08002004",
                "tbreak main",
                "continue"
            ],
            "postRestartCommands": [
                "monitor reset halt",
                "set $sp = *0x08002000",
                "set $pc = *0x08002004",
                "tbreak main",
                "continue"
