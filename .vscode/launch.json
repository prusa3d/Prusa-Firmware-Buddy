        {
            "name": "GDB - Buddy (QEMU)",
            "type": "gdb",
            "request": "attach",
            "executable": "${command:cmake.buildDirectory}/firmware",
            "target": ":1234",
            "remote": true,
            "cwd": "${workspaceRoot}",
            "gdbpath": "gdb-multiarch",
            "autorun": []
